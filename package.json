{
  "name": "flash-sale-exercise",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "server",
    "frontend"
  ],
  "scripts": {
    "dev": "docker compose up -d --wait && yarn workspaces foreach -A -pi run dev",
    "migrate:db": "yarn workspace server prisma migrate dev",
    "build": "yarn workspaces foreach -A -t run build",
    "lint": "yarn workspaces foreach -A -pi run lint",
    "format": "prettier --write \"server/src/**/*.ts\" \"server/test/**/*.ts\" \"frontend/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"server/src/**/*.ts\" \"server/test/**/*.ts\" \"frontend/src/**/*.{ts,tsx}\"",
    "test": "yarn workspace server run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.4.2"
  }
}
